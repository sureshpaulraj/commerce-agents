# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
ANTHROPIC_API_KEY=

# Or run the examples against an OpenAI-compatible Microsoft Foundry deployment, with Entra
# ID instead of a key — for a tenant that cannot deploy an Anthropic model. Set all three;
# docs/deployment.md explains what the translation keeps and what it drops.
# COMMERCE_DEMO_PROVIDER=foundry-openai
# FOUNDRY_RESOURCE=your-account
# FOUNDRY_DEPLOYMENT=your-deployment
