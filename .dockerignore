#
# What never belongs in a build context: version control, virtualenvs, installed
# dependencies, build output, caches, and any local credential file.
#
# No pattern ends in a slash, and every globbed pattern is paired with its bare form.
# The packer that uploads a build context to a remote builder anchors each rule as
# `^rule$` against a path that carries no trailing slash, so `node_modules/` matches
# nothing at all, and `**/node_modules` matches only below the top level.

.git
.github
.venv
venv

node_modules
**/node_modules
.next
**/.next

__pycache__
**/__pycache__
*.pyc
**/*.pyc
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
*.egg-info
**/*.egg-info

.env
**/.env
**/.memory-store.json
**/.memory-seeded.json
